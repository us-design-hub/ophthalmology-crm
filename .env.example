# Copy to .env.local and supply deployment-specific values, or use npm run db:local:init.
# Never point demo setup or seed scripts at a production database.
APP_MODE=demo
APP_ORIGIN=http://127.0.0.1:3000
HOSPITAL_CODE=DEMO
DATABASE_URL=postgresql://openeyes_app:REPLACE@127.0.0.1:55432/openeyes_demo
# Put DATABASE_ADMIN_URL in a separate .env.db.local used only by database scripts.
# Independent 32-byte base64 values, generated by local initialization.
IDENTIFIER_ENCRYPTION_KEY=REPLACE
IDENTIFIER_INDEX_KEY=REPLACE
SESSION_PEPPER=REPLACE
# Showing demo credentials requires both APP_MODE=demo and this explicit flag.
# Passwords are verified normally; this never bypasses authentication.
SHOW_DEMO_CREDENTIALS=false
DEMO_ACCOUNT_PASSWORD=REPLACE_WITH_A_UNIQUE_DEMO_PASSWORD
TRUST_PROXY=false

# For hosted PostgreSQL with a private CA, base64-encode the trusted PEM certificate.
# Leave DATABASE_URL free of sslmode/sslrootcert parameters when using this setting.
DATABASE_SSL_CA_BASE64=
