# Production template. Copy into a protected secret manager or local ignored file.
APP_MODE=production
APP_ORIGIN=https://clinical.example.com
HOSPITAL_CODE=HOSPITAL_CODE
DATABASE_URL=postgresql://openeyes_app:REPLACE@production-db.example.com:5432/openeyes
# Administrative URL is used only by migration and preflight jobs, never the application runtime.
DATABASE_ADMIN_URL=postgresql://openeyes_owner:REPLACE@production-db.example.com:5432/openeyes

# Generate three independent values, each containing exactly 32 random bytes encoded as base64.
IDENTIFIER_ENCRYPTION_KEY=REPLACE
IDENTIFIER_INDEX_KEY=REPLACE
SESSION_PEPPER=REPLACE

SHOW_DEMO_CREDENTIALS=false
# Enable only behind a trusted proxy that replaces forwarded client-IP headers.
TRUST_PROXY=false

# For hosted PostgreSQL with a private CA, base64-encode the trusted PEM certificate.
DATABASE_SSL_CA_BASE64=

# One-time production bootstrap. Remove initial passwords after bootstrap.
PRODUCTION_HOSPITAL_NAME=Hospital name
PRODUCTION_MRN_PREFIX=HSP
PRODUCTION_FACILITY_NAME=Main eye clinic
INITIAL_HOSPITAL_ADMIN_EMAIL=administrator@example.com
INITIAL_HOSPITAL_ADMIN_NAME=Hospital Administrator
INITIAL_HOSPITAL_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_TEMPORARY_PASSWORD
INITIAL_SECURITY_ADMIN_EMAIL=security@example.com
INITIAL_SECURITY_ADMIN_NAME=Security Administrator
INITIAL_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_TEMPORARY_PASSWORD

# Odoo synchronization.
ODOO_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ODOO_SERVICE_ACCOUNT_EMAIL=odoo.integration@example.com
ODOO_DEFAULT_FACILITY_ID=REPLACE_WITH_CLINIC_UUID

# Required until PDF rendering moves to a dedicated service.
PDF_CHROMIUM_EXECUTABLE=/opt/chromium/chrome
